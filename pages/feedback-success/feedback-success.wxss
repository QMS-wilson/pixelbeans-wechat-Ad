.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  background: linear-gradient(180deg, #f8fafc, #eef2ff);
  box-sizing: border-box;
}
.icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #22c55e, #16a34a);
  color: #fff;
  font-size: 72rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}
.title { font-size: 36rpx; font-weight: 800; color: #0f172a; }
.sub { color: #64748b; font-size: 26rpx; margin: 16rpx 0 48rpx; text-align: center; }
.btn {
  width: 60%;
  background: linear-gradient(135deg, #3157d5, #6d4aff);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
}
