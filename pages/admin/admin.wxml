<view class="page">
  <view class="head">
    <text class="title">卡密管理</text>
    <text class="back" bindtap="goBack">返回</text>
  </view>

  <view class="status {{statusType}}">{{statusText}}</view>

  <view class="panel">
    <view class="row">
      <text class="label">管理员密钥</text>
      <input class="input" password value="{{adminKey}}" bindinput="onAdminKeyInput" placeholder="请输入管理密码" />
    </view>
    <view class="row-actions">
      <button class="btn primary" bindtap="loadCards" disabled="{{loading}}">加载数据</button>
      <button class="btn ghost" bindtap="clearKey">清除密钥</button>
    </view>
  </view>

  <view class="panel" wx:if="{{loaded}}">
    <view class="summary">
      共 {{cards.length}} 张 · 未使用 {{summary.unused}} · 已激活 {{summary.active}} · 已失效 {{summary.exhausted}}
    </view>
    <scroll-view scroll-y class="card-list">
      <view class="card-item" wx:for="{{cards}}" wx:key="code">
        <view class="card-info">
          <view class="code-row">
            <text class="code" data-code="{{item.code}}" bindtap="copyCardCode">{{item.code}}</text>
            <text class="copy-hint" data-code="{{item.code}}" bindtap="copyCardCode">复制</text>
          </view>
          <text class="meta">{{item.statusText}} · AI {{item.aiOptimizeCount}}/3 · 下载 {{item.downloadCount}}/3 · {{item.createdAtText}}</text>
          <text class="note" wx:if="{{item.note}}">{{item.note}}</text>
        </view>
        <button class="btn mini" size="mini" disabled="{{item.status === 'unused' || loading}}" data-code="{{item.code}}" bindtap="resetCard">重置</button>
      </view>
      <view class="empty" wx:if="{{!cards.length}}">暂无卡密</view>
    </scroll-view>
  </view>

  <view class="panel">
    <text class="panel-title">批量生成</text>
    <view class="row">
      <text class="label">数量</text>
      <input class="input" type="number" value="{{genCount}}" bindinput="onGenCount" />
    </view>
    <view class="row">
      <text class="label">前缀</text>
      <input class="input" value="{{genPrefix}}" bindinput="onGenPrefix" />
    </view>
    <view class="row">
      <text class="label">备注</text>
      <input class="input" value="{{genNote}}" bindinput="onGenNote" />
    </view>
    <button class="btn primary" bindtap="generateCards" disabled="{{!adminKey || loading}}">生成卡密</button>
  </view>

  <view class="panel" wx:if="{{logs.length}}">
    <text class="panel-title">最近日志（最多 200 条）</text>
    <scroll-view scroll-y class="log-list">
      <view class="log-item" wx:for="{{logs}}" wx:key="id">
        <text class="log-type">{{item.type}}</text>
        <text class="log-detail">{{item.detail}}</text>
        <text class="log-time">{{item.createdAtText}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="toast {{messageType}}" wx:if="{{message}}">{{message}}</view>
</view>
