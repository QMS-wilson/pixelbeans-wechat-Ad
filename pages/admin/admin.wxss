.page {
  min-height: 100vh;
  padding: 24rpx;
  background: linear-gradient(180deg, #f8fafc, #eef2ff);
  box-sizing: border-box;
}
.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.title { font-size: 38rpx; font-weight: 800; color: #0f172a; }
.back { color: #3157d5; font-size: 28rpx; }
.status {
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
  line-height: 1.5;
}
.status.info { background: rgba(49, 87, 213, 0.08); color: #3157d5; }
.status.success { background: rgba(34, 197, 94, 0.1); color: #166534; }
.status.warn { background: rgba(245, 158, 11, 0.12); color: #92400e; }
.status.error { background: rgba(239, 68, 68, 0.1); color: #b91c1c; }
.panel {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.06);
}
.panel-title { font-size: 28rpx; font-weight: 700; display: block; margin-bottom: 16rpx; }
.row { display: flex; align-items: center; margin-bottom: 16rpx; }
.label { width: 160rpx; font-size: 26rpx; color: #64748b; }
.input {
  flex: 1;
  min-height: 72rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}
.row-actions { display: flex; gap: 16rpx; }
.btn { flex: 1; border-radius: 14rpx; font-size: 28rpx; font-weight: 700; }
.btn.primary { background: linear-gradient(135deg, #3157d5, #6d4aff); color: #fff; }
.btn.ghost { background: rgba(49, 87, 213, 0.1); color: #3157d5; }
.btn.mini { flex: none; padding: 0 24rpx; font-size: 24rpx; }
.summary { font-size: 26rpx; color: #475569; margin-bottom: 16rpx; }
.card-list { max-height: 520rpx; }
.card-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.06);
}
.card-info { flex: 1; margin-right: 16rpx; min-width: 0; }
.code-row { display: flex; align-items: center; gap: 12rpx; }
.code { display: block; font-family: ui-monospace, monospace; font-weight: 800; font-size: 26rpx; }
.copy-hint {
  color: #3157d5;
  font-size: 22rpx;
  background: rgba(49, 87, 213, 0.1);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.meta { display: block; color: #64748b; font-size: 22rpx; margin-top: 6rpx; }
.note { display: block; color: #94a3b8; font-size: 22rpx; margin-top: 4rpx; }
.empty { color: #94a3b8; text-align: center; padding: 40rpx 0; }
.log-list { max-height: 420rpx; }
.log-item { padding: 14rpx 0; border-bottom: 1rpx solid rgba(15, 23, 42, 0.05); }
.log-type { color: #4338ca; font-size: 22rpx; font-weight: 700; margin-right: 12rpx; }
.log-detail { color: #334155; font-size: 24rpx; }
.log-time { display: block; color: #94a3b8; font-size: 20rpx; margin-top: 4rpx; }
.toast {
  position: fixed;
  left: 50%;
  bottom: 80rpx;
  transform: translateX(-50%);
  background: rgba(15, 23, 42, 0.85);
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  z-index: 99;
}
.toast.error { background: rgba(185, 28, 28, 0.9); }
