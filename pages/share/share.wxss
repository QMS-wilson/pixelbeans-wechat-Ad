.page {
  min-height: 100vh;
  background: #f8fafc;
  padding-bottom: 48rpx;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #eef2f7;
}

.title {
  font-size: 36rpx;
  font-weight: 800;
  color: #111827;
}

.back {
  font-size: 26rpx;
  color: #3157d5;
}

.center-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 48rpx;
  gap: 20rpx;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #e2e8f0;
  border-top-color: #3157d5;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.error-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #111827;
}

.state-sub {
  font-size: 26rpx;
  color: #687385;
  text-align: center;
}

.btn {
  margin-top: 12rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 2.6;
}

.btn.primary {
  background: #3157d5;
  color: #ffffff;
}

.btn.ghost {
  background: #ffffff;
  color: #111827;
  border: 1rpx solid #e2e8f0;
}

.share-meta {
  display: flex;
  flex-direction: column;
  padding: 28rpx 32rpx 8rpx;
  gap: 6rpx;
}

.share-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #111827;
}

.share-sub {
  font-size: 26rpx;
  color: #687385;
}

.share-sub.warn {
  color: #b45309;
}

.compare-panel {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

.compare-item {
  flex: 1;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(17, 24, 39, 0.05);
}

.compare-label {
  display: block;
  font-size: 24rpx;
  color: #687385;
  margin-bottom: 12rpx;
}

.thumb-canvas {
  width: 100%;
  height: 300rpx;
  background: #ffffff;
}

.canvas-panel {
  padding: 8rpx 32rpx;
}

.canvas-label {
  display: block;
  font-size: 26rpx;
  color: #687385;
  margin-bottom: 12rpx;
}

.share-canvas {
  width: 100%;
  height: 720rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(17, 24, 39, 0.05);
}

.share-actions {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

.share-actions .btn {
  flex: 1;
}
